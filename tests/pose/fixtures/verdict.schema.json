{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SA Fine-Tune Verdict",
  "description": "Stable contract for the SuperAnimal fine-tune comparison verdict (schema 1.0).",
  "type": "object",
  "required": [
    "schema_version",
    "baseline_id",
    "candidate_id",
    "n_frames_compared",
    "keypoints",
    "hd",
    "gate",
    "gate_pass_per_keypoint",
    "overall_pass",
    "fail_reasons",
    "generated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "baseline_id": {"type": "string"},
    "candidate_id": {"type": "string"},
    "n_frames_compared": {"type": "integer", "minimum": 0},
    "keypoints": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/keypoint"}
    },
    "hd": {"type": "object"},
    "gate": {"$ref": "#/$defs/gate"},
    "gate_pass_per_keypoint": {"type": "object"},
    "overall_pass": {"type": "boolean"},
    "fail_reasons": {"type": "array", "items": {"type": "string"}},
    "generated_at": {"type": "string"},
    "meta": {"type": "object"}
  },
  "$defs": {
    "keypoint": {
      "type": "object",
      "required": [
        "keypoint", "n_pairs",
        "median_baseline_px", "median_candidate_px", "pct_change_median",
        "p_value_wilcoxon", "rank_biserial_r",
        "bootstrap_ci_baseline", "bootstrap_ci_candidate",
        "pck_5_baseline", "pck_10_baseline", "pck_20_baseline",
        "pck_5_candidate", "pck_10_candidate", "pck_20_candidate",
        "p90_baseline", "p90_candidate", "pct_change_p90"
      ],
      "additionalProperties": false,
      "properties": {
        "keypoint": {"type": "string"},
        "n_pairs": {"type": "integer", "minimum": 0},
        "median_baseline_px": {"type": "number"},
        "median_candidate_px": {"type": "number"},
        "pct_change_median": {"type": "number"},
        "p_value_wilcoxon": {"type": "number"},
        "rank_biserial_r": {"type": "number"},
        "bootstrap_ci_baseline": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 3,
          "maxItems": 3
        },
        "bootstrap_ci_candidate": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 3,
          "maxItems": 3
        },
        "pck_5_baseline": {"type": "number"},
        "pck_10_baseline": {"type": "number"},
        "pck_20_baseline": {"type": "number"},
        "pck_5_candidate": {"type": "number"},
        "pck_10_candidate": {"type": "number"},
        "pck_20_candidate": {"type": "number"},
        "p90_baseline": {"type": "number"},
        "p90_candidate": {"type": "number"},
        "pct_change_p90": {"type": "number"}
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "alpha", "nose_required_pct_reduction", "tail_required_pct_reduction",
        "head_p90_required_pct_reduction", "rank_biserial_min",
        "other_keypoint_max_regression_pct", "other_keypoint_regression_p_max"
      ],
      "additionalProperties": false,
      "properties": {
        "alpha": {"type": "number"},
        "nose_required_pct_reduction": {"type": "number"},
        "tail_required_pct_reduction": {"type": "number"},
        "head_p90_required_pct_reduction": {"type": "number"},
        "rank_biserial_min": {"type": "number"},
        "other_keypoint_max_regression_pct": {"type": "number"},
        "other_keypoint_regression_p_max": {"type": "number"}
      }
    }
  }
}
